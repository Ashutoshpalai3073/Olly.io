{
  "name": "olly",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" --names \"frontend\"",
    "build": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "deploy": "vercel --prod",
    "lint": "npm run lint --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vercel": "^39.0.0"
  }
}
