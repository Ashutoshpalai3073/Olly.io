# ─────────────────────────────────────────────
# Olly — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────

# ── Groq AI ──────────────────────────────────
# Used server-side only (API functions).
# Obtain at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Supabase ─────────────────────────────────
# Project URL — found in Supabase dashboard → Settings → API
SUPABASE_URL=https://bdktrzzzrxkgaluqwtai.supabase.co
# Anon/public key — safe to expose to the browser
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJka3Ryenp6cnhrZ2FsdXF3dGFpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA2NjI4ODUsImV4cCI6MjA5NjIzODg4NX0.1gjOA9yhauQsnRG7ULT3_-rLM6AG0KxZ_p9YY277V6A
# Service role key — SECRET, server-side only, bypasses RLS
